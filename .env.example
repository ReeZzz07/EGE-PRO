# Скопируй в .env (в корне проекта) и заполни. Читают: Vite при сборке на хосте (npm run build,
# только VITE_-переменные — см. SETUP.md), docker-compose.yml (${VAR} — контейнеры api/postgrest)
# и scripts/import/publish-*.mjs.

# Адрес и (неиспользуемый по-настоящему, но обязательный непустой) ключ бэкенда — Vite вклеивает
# их в собранный бандл. Порт должен совпадать с тем, что проброшен наружу в docker-compose.yml
# (сейчас 3100).
VITE_SUPABASE_URL=http://localhost:3100
VITE_SUPABASE_ANON_KEY=local-anon-key-unused

# Домен для canonical/og:url и т.п. (см. src/lib/seo.ts) — заглушка, пока реального домена нет.
VITE_SITE_URL=https://ege-pro.ru

# Общий JWT-секрет контейнеров api и postgrest (docker-compose.yml) — им подписываются токены
# входа и по нему PostgREST проверяет их подлинность для RLS. Смени на свою случайную строку
# перед чем-либо, что не чисто локальный эксперимент.
JWT_SECRET=change_me_to_a_long_random_string

# Пароль суперпользователя Postgres (сервис postgres в docker-compose.yml) и пароль роли
# authenticator, которой стучится postgrest (см. docker/pg-init/0000_bootstrap.sql). Постгрес
# применяет POSTGRES_PASSWORD только при первой инициализации ТОМА — если у тебя уже есть volume
# pgdata, поднятый со старыми значениями, здесь должны стоять именно они (иначе postgrest не
# подключится). Меняешь пароль на новый — либо через ALTER ROLE на живой базе, либо сносишь
# volume и поднимаешь стек заново.
POSTGRES_PASSWORD=change_me_to_a_long_random_string
AUTHENTICATOR_PASSWORD=change_me_to_a_long_random_string

# Ключ для ИИ-репетитора (docker/api/server.js -> POST /ai-tutor: подсказки, объяснение тем,
# проверка сочинений). Без него подсказки работают в офлайн-фолбэке (см. src/lib/aiTutor.ts) —
# приложение не ломается, просто ИИ не настоящий. Провайдера и ключ также можно (и предпочтительнее)
# задать прямо в админке платформы (/admin → «ИИ-репетитор») — эта переменная лишь запасной вариант.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# SMTP для писем (подтверждение email, сброс пароля, чек об оплате — docker/api/mailer.js). Без
# него письма просто не отправляются (регистрация/оплата не ломаются, только тихо не шлют email —
# см. лог "SMTP не настроен"). Как и с ИИ-репетитором выше, предпочтительнее задать в админке
# (/admin → «Почта») — эта переменная лишь запасной вариант.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@ege-tutor.ru
# SMTP_PASSWORD=пароль-приложения
# SMTP_FROM_NAME=ЕГЭ·ПРО
# SMTP_FROM_ADDRESS=noreply@ege-tutor.ru

# Под каким пользователем логинятся scripts/import/publish-to-supabase.mjs и publish-neofamily.mjs
# (нужен существующий аккаунт с is_admin=true — см. «Первый администратор» в SETUP.md).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Адрес локального стека для тех же скриптов импорта — можно не задавать, по умолчанию
# http://localhost:3100.
# LOCAL_BACKEND_URL=http://localhost:3100
