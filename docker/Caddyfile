# Конфиг Caddy для прод-деплоя (см. docker-compose.prod.yml → сервис caddy, SETUP.md → "Прод-деплой").
# {$SITE_DOMAIN} — переменная окружения контейнера, равна VITE_SUPABASE_URL из .env (полный
# https://домен). Caddy сам выпускает и продлевает TLS-сертификат (Let's Encrypt) для этого домена
# при первом запуске — никаких дополнительных настроек не нужно, только чтобы DNS A-запись домена
# уже указывала на IP сервера и порты 80/443 были открыты (см. scripts/setup-firewall.sh).
{$SITE_DOMAIN} {
	reverse_proxy web:3000
}
