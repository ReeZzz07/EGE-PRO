# Конфиг Caddy для прод-деплоя (см. docker-compose.prod.yml → сервис caddy, SETUP.md → "Прод-деплой").
# {$SITE_HOST} — голый домен без схемы (напр. ege-tutor.ru), отдельная переменная от
# VITE_SUPABASE_URL (там — полный https://домен для Vite, схема тут не нужна и мешала бы собрать
# адрес www.<домен> прямой конкатенацией). Caddy сам выпускает и продлевает TLS-сертификаты
# Let's Encrypt для обоих адресов при первом запуске — нужно только, чтобы A-запись домена И его
# www-поддомена уже указывали на IP сервера, а порты 80/443 были открыты (см. scripts/setup-firewall.sh).
# www — постоянный редирект (301) на основной домен с сохранением пути и параметров: раньше оба
# адреса отдавали одинаковый сайт с кодом 200, и для Яндекса/Google это дубль-зеркало (canonical
# в разметке страниц и так указывает на домен без www). Блок нужен именно отдельным, а не
# снятием www с адреса ниже: Caddy выпускает TLS-сертификат и для www тоже — иначе https://www
# показывал бы ошибку сертификата вместо редиректа.
www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST} {
	# Сжатие ответов: без него JS-бандл (~1 МБ), JSON банка заданий (у русского языка ~25 МБ) и SVG-формулы
	# уходили как есть — по каналу до пользователей это давало секунды ожидания (формулы «долго грузятся»).
	# Картинки/аудио/архивы Caddy по умолчанию не пережимает.
	encode zstd gzip

	# Access-лог в stdout (docker compose logs caddy) — без него нельзя было проверить, какой
	# User-Agent реально прислал Telegram/VK и попал ли он под @bot ниже; выяснилось это только
	# постфактум, когда превью в реальных чатах не появилось. Формат console — читаемый через
	# docker logs, не raw JSON.
	log {
		output stdout
		format console
	}

	# Публичные страницы отдаёт api ВСЕМ клиентам, а не только ботам: готовый HTML с настоящим содержимым (h1, текст, цены, уникальные
	# title/description/canonical, JSON-LD) внутри оболочки сайта; React при старте заменяет его приложением (docker/api/spaShell.js,
	# botPages.js, blogBot.js). Раньше сюда шли только боты по User-Agent, а остальные клиенты, например SEO-аудит или нейросеть с обычным
	# User-Agent, видели пустую оболочку одинакового размера на любом адресе, и GEO настроить было нельзя. Превью в мессенджерах и верификация
	# Search Console (раньше отдельные правила по User-Agent) работают теми же страницами.
	#
	# lb_policy first: пока api жив, ходим к нему; если он недоступен (перезапуск, сбой), Caddy сразу отдаёт то же приложение с web, то есть
	# сайт для людей не зависит от api так, как зависели бы они от единственного upstream.
	@public {
		method GET HEAD
		path / /tariffs /parents /contacts /oferta /privacy /blog /blog/* /llms.txt
	}
	handle @public {
		reverse_proxy api:8787 web:3000 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			fail_duration 10s
			max_fails 1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
